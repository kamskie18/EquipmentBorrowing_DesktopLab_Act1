<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Campus Equipment Borrowing System"
        Width="900" Height="600">

    <Grid ColumnDefinitions="200,*">

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#2C3E50" Spacing="4" Margin="0">
            <TextBlock Text="Campus Equipment"
                       FontSize="18" FontWeight="Bold"
                       Foreground="White" Margin="16"/>
            <Button Content="Equipment"
                    Command="{Binding ShowEquipmentCommand}"
                    HorizontalAlignment="Stretch" Margin="8,4"/>
            <Button Content="Active Borrowings"
                    Command="{Binding ShowBorrowingsCommand}"
                    HorizontalAlignment="Stretch" Margin="8,4"/>
        </StackPanel>

        <!-- Main content area -->
        <ContentControl Grid.Column="1"
                         Content="{Binding CurrentView}"
                         Margin="16"/>

    </Grid>
</Window>