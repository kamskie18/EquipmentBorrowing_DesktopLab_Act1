<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.CheckoutView"
             x:DataType="vm:CheckoutViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Equipment Checkout (Single &amp; Multi-Item)" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Main Body: 2 Columns -->
        <Grid Grid.Row="1" ColumnDefinitions="1.3*,1.2*" Margin="0,0,0,8">

            <!-- Left: Select Available Equipment -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Select Available Equipment (Check multiple for UC-06)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding AvailableEquipment}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,2" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,Auto,*">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Grid.Column="1" Background="#4A5568" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Equipment.EquipmentIdentifier}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Equipment.Name}" FontWeight="Bold" Foreground="#2D3748"/>
                                            <TextBlock Text="{Binding Equipment.Description, TargetNullValue='No description'}" FontSize="11" Foreground="#4A5568" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Borrower Details & Action Panel -->
            <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="16">

                    <!-- Student Selection -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Select Borrower Student:" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Students}"
                                  SelectedItem="{Binding SelectedStudent}"
                                  PlaceholderText="-- Select Student --"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding StudentNumber, StringFormat='[{0}]'}" FontWeight="Bold" Foreground="#3182CE"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#2D3748"/>
                                        <TextBlock Text="{Binding IsAllowedToBorrow, StringFormat='(Eligible: {0})'}" Foreground="#4A5568" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Expected Return Date Picker (BR-11) -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Expected Return Date (BR-11):" FontWeight="SemiBold"/>
                        <DatePicker SelectedDate="{Binding ExpectedReturnDate}" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="* Expected return date must be strictly later than today's checkout date." FontSize="11" Foreground="#718096"/>
                    </StackPanel>

                    <!-- Test Seam Option for Acceptance A06 -->
                    <Border Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel Spacing="4">
                            <CheckBox Content="Simulate Failure Seam (A06 Verification)"
                                      IsChecked="{Binding SimulateFailureSeam}"
                                      Foreground="#C53030" FontWeight="SemiBold"/>
                            <TextBlock Text="When enabled, induces an exception inside the transaction after the first write to verify that atomic rollback leaves ZERO partial changes in PostgreSQL."
                                       FontSize="10" Foreground="#E53E3E" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Checkout Buttons -->
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <Button Content="Borrow Single Item (UC-03)"
                                Command="{Binding BorrowSingleCommand}"
                                HorizontalAlignment="Stretch"
                                Background="#4A5568" Foreground="White"
                                HorizontalContentAlignment="Center"/>

                        <Button Content="Check Out Multiple Items (Atomic UC-06)"
                                Command="{Binding CheckoutMultipleCommand}"
                                HorizontalAlignment="Stretch"
                                Background="#2B6CB0" Foreground="White" FontWeight="Bold"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer / Status Feedback (BR-18, BR-19) -->
        <Border Grid.Row="2" Background="#EDF2F7" Padding="10,6" CornerRadius="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsLoading}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
