<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Active Equipment Borrowings (UC-04)" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Main Body: Active List + Return Action -->
        <Grid Grid.Row="1" ColumnDefinitions="1.5*,1*" Margin="0,0,0,8">

            <!-- Left: List of Active Borrowings -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Current Active Loans" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ActiveBorrowings}"
                             SelectedItem="{Binding SelectedBorrowing}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,2" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Border Background="#4A5568" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding Equipment.EquipmentIdentifier, TargetNullValue='Unknown'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="{Binding Equipment.Name, TargetNullValue='Equipment'}" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Student.Name, StringFormat='Borrower: {0}'}" FontSize="12" Foreground="#2D3748"/>
                                            <TextBlock Text="{Binding DateBorrowed, StringFormat='Checked out: {0:MMM dd, yyyy}'}" FontSize="11" Foreground="#718096"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#EBF8FF" CornerRadius="4" Padding="6,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ExpectedReturnDate, StringFormat='Due: {0:MMM dd, yyyy}'}" FontSize="11" FontWeight="Bold" Foreground="#2B6CB0"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Return Panel (UC-05) -->
            <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Return Equipment (UC-05)" FontWeight="Bold" Foreground="#2B6CB0"/>

                    <TextBlock Text="Select an active borrowing record on the left to proceed with return."
                               FontSize="12" Foreground="#718096" TextWrapping="Wrap"/>

                    <Border Background="#EDF2F7" CornerRadius="4" Padding="10">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Selected Loan Summary:" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedBorrowing.Equipment.Name, TargetNullValue='None selected', StringFormat='Item: {0}'}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedBorrowing.Student.Name, TargetNullValue='-', StringFormat='Borrower: {0}'}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedBorrowing.ExpectedReturnDate, TargetNullValue='-', StringFormat='Due: {0:MMM dd, yyyy}'}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Confirm Equipment Return (UC-05)"
                            Command="{Binding ReturnCommand}"
                            HorizontalAlignment="Stretch"
                            Background="#38A169" Foreground="White" FontWeight="Bold"
                            HorizontalContentAlignment="Center"/>

                    <TextBlock Text="* Returning marks the item available, sets the actual return date to today, preserves borrowing history, and blocks repeat returns (BR-13)."
                               FontSize="11" Foreground="#718096" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer / Feedback -->
        <Border Grid.Row="2" Background="#EDF2F7" Padding="10,6" CornerRadius="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsLoading}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>