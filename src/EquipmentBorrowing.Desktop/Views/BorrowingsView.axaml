<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <TextBlock Grid.Row="0" Text="Active Borrowings"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding ActiveBorrowings}"
                 SelectedItem="{Binding SelectedBorrowing}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="0,2" BorderBrush="Gray" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding EquipmentId, StringFormat='Equipment ID: {0}'}"/>
                            <TextBlock Text="{Binding ExpectedReturnDate, StringFormat='Due: {0:MMM dd, yyyy}'}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
            <Button Content="Return Equipment"
                    Command="{Binding ReturnCommand}"
                    HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Red"/>
        </StackPanel>

    </Grid>
</UserControl>