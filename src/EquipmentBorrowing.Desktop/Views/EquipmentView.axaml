<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- Top Header & Filters (UC-01, UC-02) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Equipment Catalog" FontSize="20" FontWeight="Bold"/>
            <CheckBox Grid.Column="1" Content="Show Available Only (UC-02)" IsChecked="{Binding ShowAvailableOnly}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Main Body: 2 Columns -->
        <Grid Grid.Row="1" ColumnDefinitions="1.2*,1.5*" Margin="0,0,0,8">

            <!-- Left: Equipment List -->
            <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Equipment Items" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding EquipmentList}"
                             SelectedItem="{Binding SelectedEquipment}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,2" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" Background="#4A5568" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EquipmentIdentifier}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#2D3748"/>
                                            <TextBlock Text="{Binding Description, TargetNullValue='No description'}" FontSize="11" Foreground="#4A5568" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Forms (Registration UC-15 & Edit UC-16) -->
            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="16">

                    <!-- Register Equipment Box (UC-15) -->
                    <Border Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Register New Equipment (UC-15)" FontWeight="Bold" Foreground="#2B6CB0"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Equipment Identifier:" FontSize="11" Foreground="#2D3748"/>
                                    <TextBox Text="{Binding NewIdentifier}" PlaceholderText="e.g. EQ-006"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Equipment Name:" FontSize="11" Foreground="#2D3748"/>
                                    <TextBox Text="{Binding NewName}" PlaceholderText="e.g. Function Generator"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Description / Specifications (Optional):" FontSize="11" Foreground="#2D3748"/>
                            <TextBox Text="{Binding NewDescription}" PlaceholderText="e.g. 25MHz arbitrary waveform generator"/>
                            <Button Content="Register Equipment" Command="{Binding RegisterEquipmentCommand}" HorizontalAlignment="Right" Background="#3182CE" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- Edit Equipment Box (UC-16) -->
                    <Border Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Edit Selected Equipment (UC-16)" FontWeight="Bold" Foreground="#2B6CB0"/>
                            <TextBlock Text="Note: Availability status is managed exclusively via borrow/return workflows." FontSize="11" Foreground="#4A5568"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Equipment Identifier:" FontSize="11" Foreground="#2D3748"/>
                                    <TextBox Text="{Binding EditIdentifier}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Equipment Name:" FontSize="11" Foreground="#2D3748"/>
                                    <TextBox Text="{Binding EditName}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Description / Specifications:" FontSize="11" Foreground="#2D3748"/>
                            <TextBox Text="{Binding EditDescription}"/>
                            <Button Content="Save Changes" Command="{Binding UpdateEquipmentCommand}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer / Feedback -->
        <Border Grid.Row="2" Background="#EDF2F7" Padding="10,6" CornerRadius="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressBar IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsLoading}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>