<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <TextBlock Grid.Row="0" Text="Available Equipment"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding EquipmentList}"
                 SelectedItem="{Binding SelectedEquipment}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="0,2" BorderBrush="Gray" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
            <ComboBox ItemsSource="{Binding StudentList}"
                      SelectedItem="{Binding SelectedStudent}"
                      PlaceholderText="Select Student">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Content="Borrow Equipment"
                    Command="{Binding BorrowCommand}"
                    HorizontalAlignment="Left"/>

            <TextBlock Text="{Binding StatusMessage}" Foreground="Red"/>
        </StackPanel>

    </Grid>
</UserControl>